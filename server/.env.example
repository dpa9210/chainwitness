# Auto-populated by Vercel once the Blob store and Upstash Redis integration
# are linked to this project — run `vercel env pull .env.local` to fetch the
# real values instead of setting these by hand.

# Vercel Blob (photo storage)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (post metadata + feed index) — @upstash/redis's
# Redis.fromEnv() also accepts the legacy KV_REST_API_URL/TOKEN names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
